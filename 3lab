    axes[3, 3].set_title(titles[3])
    axes[3, 4].imshow(results2['jpeg']['gaussian'])
    axes[3, 4].set_title(titles[4])

    for ax in axes.flatten():
        ax.axis('off')

    plt.tight_layout()
    plt.show()

base_path = '/content/'

res1 = process_image(os.path.join(base_path, 'piemers1.jpg'))
