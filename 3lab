    axes[1, 1].imshow(results1['jpeg']['noisy'])
    axes[1, 1].set_title(f"P1: JPEG artefakti\n{titles[1]}")
    axes[1, 2].imshow(results1['jpeg']['mean'])
    axes[1, 2].set_title(titles[2])
    axes[1, 3].imshow(results1['jpeg']['median'])
    axes[1, 3].set_title(titles[3])
    axes[1, 4].imshow(results1['jpeg']['gaussian'])
    axes[1, 4].set_title(titles[4])

    axes[2, 0].imshow(results2['original'])
    axes[2, 0].set_title(titles[0])
    axes[2, 1].imshow(results2['gauss']['noisy'])
    axes[2, 1].set_title(f"P2: Gausa troksnis\n{titles[1]}")
    axes[2, 2].imshow(results2['gauss']['mean'])
    axes[2, 2].set_title(titles[2])
    axes[2, 3].imshow(results2['gauss']['median'])
    axes[2, 3].set_title(titles[3])
    axes[2, 4].imshow(results2['gauss']['gaussian'])
    axes[2, 4].set_title(titles[4])

    axes[3, 0].imshow(results2['original'])
